<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">MCP Drone on %h</name>
  <service>
    <type>_ssh._tcp</type>
    <port>22</port>
    <txt-record>product=mcp-drone-os</txt-record>
    <txt-record>role=worker</txt-record>
    <txt-record>protocol=ssh-jsonl</txt-record>
  </service>
</service-group>
