#!/usr/bin/env bash
set -euo pipefail

iface=""
for path in /sys/class/net/*; do
  name=${path##*/}
  [ "$name" = lo ] && continue
  [ -r "$path/operstate" ] || continue
  [ "$(cat "$path/operstate")" = up ] || continue
  iface=$name
  break
done

suffix="local"
if [ -n "$iface" ] && [ -r "/sys/class/net/$iface/address" ]; then
  suffix=$(tr -d ':' < "/sys/class/net/$iface/address" | tail -c 7)
fi
hostname_value="mcp-drone-$suffix"
hostname "$hostname_value"
printf '%s\n' "$hostname_value" > /etc/hostname
install -d -m 0755 /run/mcp-drone
{
  printf 'hostname=%s\n' "$hostname_value"
  printf 'interface=%s\n' "${iface:-unknown}"
  printf 'addresses=\n'
  ip -brief address
  printf 'memory=\n'
  awk '/MemTotal:/ {print $2 " kB"}' /proc/meminfo
  printf 'cpus=%s\n' "$(nproc)"
} | tee /run/mcp-drone/identity
logger -t mcp-drone "ready hostname=$hostname_value interface=${iface:-unknown}"
