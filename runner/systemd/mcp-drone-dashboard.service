[Unit]
Description=mcp-drone-os LAN control dashboard
After=mcp-drone-mcp.service
Requires=mcp-drone-mcp.service

[Service]
User=mcp-control
ExecStart=/usr/local/libexec/mcp-drone-dashboard --bind 127.0.0.1
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/mcp-drone

[Install]
WantedBy=multi-user.target
