{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-drone-os.local/schemas/manifest-v1.json",
  "type": "object",
  "required": ["version", "agents"],
  "properties": {
    "version": {"const": 1},
    "hostname": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "lan_cidr": {"type": "string"},
    "persistence": {"enum": ["disposable", "persistent-capable"]},
    "agents": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "public_keys"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}, "display_name": {"type": "string"}, "public_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "quota": {"type": "object", "properties": {"cpu": {"type": "integer", "minimum": 1}, "memory_mb": {"type": "integer", "minimum": 128}}}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
